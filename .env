# Endereço da API (sem /api no final).
# - Navegador / simulador iOS: http://localhost:8080
# - Emulador Android: http://10.0.2.2:8080
# - Celular físico: use o IP do computador na rede, ex.: http://192.168.0.10:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# true  = usa os dados de exemplo (formato idêntico aos DTOs do backend), sem chamar a API
# false = chama a API de verdade
EXPO_PUBLIC_USAR_DADOS_EXEMPLO=true
